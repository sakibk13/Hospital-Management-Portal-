# ==============================================================================
# HealingWave Hospital Management Portal - Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env or appsettings.json file to GitHub!
# ==============================================================================

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend / MongoDB Settings
MONGODB_CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE_NAME=hospital_db

# Security & Authentication
JWT_SECRET=REPLACE_WITH_YOUR_32_BYTE_SECRET_KEY_HERE_2026!
JWT_ISSUER=HospitalManagementApi
JWT_AUDIENCE=HospitalManagementClient

# Email / SMTP Notification Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Google Gemini AI Assistant
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash
